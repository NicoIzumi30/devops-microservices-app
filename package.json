{
    "name": "microservices-devops-project",
    "version": "1.0.0",
    "description": "DevOps implementation untuk aplikasi web berbasis microservices",
    "main": "src/index.js",
    "scripts": {
        "start": "node src/index.js",
        "dev": "nodemon src/index.js",
        "build": "echo 'Build process completed'",
        "test": "jest --coverage --verbose",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "cors": "^2.8.5",
        "dotenv": "^16.0.3",
        "express": "^4.18.2",
        "helmet": "^6.0.1"
    },
    "devDependencies": {
        "jest": "^29.3.1",
        "nodemon": "^2.0.20",
        "supertest": "^6.3.3"
    },
    "jest": {
        "testEnvironment": "node",
        "coverageDirectory": "coverage",
        "collectCoverageFrom": [
            "src/**/*.js",
            "!src/index.js"
        ]
    }
}
