DB_PASS=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key

# External APIs
API_KEY=your-api-key

# Monitoring
LOG_LEVEL=info